{
  "name": "pennytrail",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3607",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 2607",
    "test:server": "next dev -H 127.0.0.1 -p 4607",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/**'",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/db-import.mjs",
    "auth:setup": "node scripts/auth-setup.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  }
}
